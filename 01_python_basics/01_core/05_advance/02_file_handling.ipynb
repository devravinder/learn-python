   "source": [
    "# File Handling\n",
    "\n",
    "Reading and writing files in Python using `open()`."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Writing to a File"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# write\n",
    "file = open(\"demo.txt\", \"w\")\n",
    "file.write(\"Hello Python\\n\")\n",
    "file.close()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Reading from a File"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# read\n",
    "file = open(\"demo.txt\", \"r\")\n",
    "print(file.read())\n",
    "file.close()"
   ]
  }
 ],
